{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sol-central-comando",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sol-central-comando-db",
      "database_id": "2eb17535-d7e9-48a7-8afa-94a2120f2565",
      "migrations_dir": "drizzle"
    }
  ]
}
